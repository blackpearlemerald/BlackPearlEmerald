# Auto detect text files and perform LF normalization
* text=auto

# Build-critical files must always use LF (WSL build tools require this)
charmap.txt text eol=lf
*.s text eol=lf
*.inc text eol=lf
*.sha1 text eol=lf
*.json text eol=lf
*.sed text eol=lf
*.cpp text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.yml text eol=lf
*.party text eol=lf
*.cfg text eol=lf
*.ld text eol=lf

*.png binary
*.bin binary

*.h linguist-language=C
*.inc linguist-language=Assembly
